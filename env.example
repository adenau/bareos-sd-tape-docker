# Required Bareos resources. Match the existing Director's configuration.
BAREOS_DIR_HOSTNAME=bareos-dir
BAREOS_DIR_PASSWORD=replace-with-director-password
BAREOS_STORAGE_NAME=Storage-Tape
BAREOS_STORAGE_PORT=9103
# Temporarily set to 100 for startup diagnostics in docker logs.
BAREOS_DEBUG_LEVEL=0
BAREOS_STORAGE_DEVICE_NAME=HP-TapeDrive0
BAREOS_MEDIA_TYPE=LTO-5
TAPE_DEVICE=/dev/nst0

# Opt in to HTTP control. Generate a dedicated token before enabling.
TAPE_WEBHOOK_ENABLED=false
TAPE_WEBHOOK_TOKEN=
TAPE_WEBHOOK_LISTEN_ADDRESS=0.0.0.0
TAPE_WEBHOOK_PORT=9080
TAPE_COMMAND_TIMEOUT=180

BAREOS_AUTOMATIC_MOUNT=yes
BAREOS_ALWAYS_OPEN=yes
BAREOS_OFFLINE_ON_UNMOUNT=yes
BAREOS_MAXIMUM_CHANGER_WAIT=600
BAREOS_MAXIMUM_REWIND_WAIT=600
BAREOS_MAXIMUM_OPEN_WAIT=600
BAREOS_MAXIMUM_CONCURRENT_JOBS=1
BAREOS_SPOOL_DIRECTORY=/var/spool/bareos
BAREOS_MAXIMUM_SPOOL_SIZE=60G

# Existing startup behavior: variable block sizes (0). Disable to leave unchanged.
TAPE_SET_BLOCK_SIZE=yes
TAPE_BLOCK_SIZE=0
